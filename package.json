{
  "name": "with-vite-react",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --parallel --filter ./apps/backend --filter ./apps/web run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.2"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
